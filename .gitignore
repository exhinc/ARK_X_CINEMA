# ================================
# ARK X CINEMA — GITIGNORE
# ================================

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.cache

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Logs / runtime output
Logs/
*.log

# Whisper test/runtime directories
Engine/_whisper_test/

# Large source media — NEVER commit
*.mp4
*.mkv
*.mov
*.avi
*.wav
*.mp3
*.m4a

# Movie working directory
# Keep legally obtained source media and temporary movie artifacts out of Git.
Movies/

# Windows shortcuts
*.lnk

# ================================
# Project artifacts are allowed
# ================================
# Projects/ contains intentional production metadata,
# manifests, state files, and production subtitle artifacts.

# Movie source directory — structure only; all contents remain local
Movies/*
!Movies/.gitkeep
